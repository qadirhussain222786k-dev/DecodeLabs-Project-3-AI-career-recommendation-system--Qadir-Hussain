# Copy this file to .env and adjust values as needed.
# The backend currently doesn't require any secrets to run locally,
# but this file is provided as a placeholder for future configuration
# (e.g. allowed CORS origins, log level, a database URL if persistence
# is added later).

# Comma-separated list of origins allowed to call the API.
# Use "*" only for local development.
CORS_ALLOWED_ORIGINS=*

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port the API should run on (used if you customize the uvicorn command)
API_PORT=8000
